+def daily_model_history(days=30):
+  """Per-day per-model token buckets for the model range switch.
+
+  Only the last `days` days travel in the record; the all-time modelUsage
+  above stays untouched. Days compare as YYYY-MM-DD strings.
+  """
+  cutoff = (now - timedelta(days=days - 1)).strftime("%Y-%m-%d")
+  by_day = {}
+  for (day, model), bucket in daily_model_usage.items():
+    if day < cutoff:
+      continue
+    by_day.setdefault(day, {})[model] = bucket
+  return [{"date": day, "models": by_day[day]} for day in sorted(by_day)]
+
