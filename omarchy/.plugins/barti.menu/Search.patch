+  Timer {
+    id: externalSearchTimer
+    interval: 150
+    repeat: false
+    property string mode: ""
+    property string query: ""
+    property int revision: 0
+    onTriggered: {
+      if (externalSearchProc.running) externalSearchProc.running = false
+      externalSearchProc.command = [root.pluginDir + "/" + (mode === "files" ? "file-search.sh" : "clipboard-search.sh"), query]
+      externalSearchProc.revision = revision
+      externalSearchProc.running = true
+    }
+  }
+
+  Process {
+    id: externalSearchProc
+    property int revision: 0
+    stdout: StdioCollector { id: externalSearchStdout; waitForEnd: true }
+    onExited: function(exitCode) {
+      if (revision !== root.externalSearchRevision) return
+
+      root.externalSearchPending = false
+      if (exitCode !== 0) {
+        root.externalSearchRows = []
+        root.externalSearchError = "Search failed"
+        root.rebuildDisplay()
+        return
+      }
+
+      try {
+        var parsed = JSON.parse(String(externalSearchStdout.text || "[]"))
+        root.externalSearchRows = Array.isArray(parsed) ? parsed : []
+        root.externalSearchError = root.externalSearchRows.length > 0 ? "" : "No matches"
+      } catch (error) {
+        root.externalSearchRows = []
+        root.externalSearchError = "Search failed"
+      }
+      root.rebuildDisplay()
+    }
+  }
