+  function updateExternalSearch() {
+    externalSearchRevision += 1
+    externalSearchTimer.stop()
+
+    var mode = root.fileSearchActive ? "files" : (root.clipboardSearchActive ? "clipboard" : "")
+    if (mode !== root.externalSearchMode) {
+      root.externalSearchMode = mode
+      root.externalSearchRows = []
+    }
+
+    root.externalSearchError = ""
+    root.externalSearchPending = false
+    if (!mode) return
+
+    var query = root.filterText.trim().slice(1).trim()
+    if (mode === "files" && !query) {
+      root.externalSearchError = "Type a file name after ?"
+      return
+    }
+
+    root.externalSearchPending = true
+    externalSearchTimer.mode = mode
+    externalSearchTimer.query = query
+    externalSearchTimer.revision = externalSearchRevision
+    externalSearchTimer.restart()
+  }
+
+  function fileName(path) {
+    var parts = String(path || "").split("/")
+    return parts.length > 0 ? parts[parts.length - 1] : String(path || "")
+  }
+
+  function displayPath(path) {
+    var home = Quickshell.env("HOME")
+    return String(path || "").indexOf(home + "/") === 0 ? "~" + String(path).slice(home.length) : String(path || "")
+  }
