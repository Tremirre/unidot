# Terminal colors (cmux reads Ghostty config from ~/.config/ghostty/config)
theme = Kanagawa Dragon

# Font
font-family = "JetBrainsMono NFM SemiBold"
font-style = Regular
font-size = 11

# Window
window-theme = ghostty
window-padding-x = 8
window-padding-y = 8
background-opacity = 0.8
background-blur = true
confirm-close-surface = false
resize-overlay = never
gtk-toolbar-style = flat

# Cursor styling
cursor-style = "block"
cursor-style-blink = false

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env

# Keyboard bindings
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
# Send modified Enter keys as CSI-u so TUIs can distinguish them.
keybind = shift+enter=csi:13;2u
keybind = alt+shift+enter=csi:13;4u
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Super is reserved for Hyprland workspaces, so Ctrl switches Ghostty tabs.
keybind = ctrl+shift+bracket_right=next_tab
keybind = ctrl+shift+bracket_left=previous_tab
keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5
keybind = ctrl+6=goto_tab:6
keybind = ctrl+7=goto_tab:7
keybind = ctrl+8=goto_tab:8
keybind = ctrl+9=goto_tab:9

# cmux-style shortcuts for tmux (sends "C-a <key>" so tmux acts on its prefix
# bindings without the user having to chord the leader first). Tmux prefix is
# C-a (\x01); see ~/.config/tmux/tmux.conf for the matching bindings.

# Splits
keybind = super+d=text:\x01|
keybind = super+shift+d=text:\x01-

# Pane focus (Cmd+Opt+Arrows)
keybind = super+alt+arrow_left=text:\x01h
keybind = super+alt+arrow_right=text:\x01l
keybind = super+alt+arrow_up=text:\x01k
keybind = super+alt+arrow_down=text:\x01j
# Hyprland consumes Cmd+Opt+Arrows, then forwards this private bridge chord.
keybind = super+control+alt+arrow_left=text:\x01h
keybind = super+control+alt+arrow_right=text:\x01l
keybind = super+control+alt+arrow_up=text:\x01k
keybind = super+control+alt+arrow_down=text:\x01j

# Open a new Ghostty tab (default Cmd+T is repurposed for tmux new-window below)
keybind = super+n=new_tab

# Close the current Ghostty tab (Cmd+W is taken by tmux kill-pane)
keybind = super+shift+w=close_tab:this
# Disable Cmd+Opt+W to avoid accidentally closing tabs
keybind = super+alt+w=ignore

# Spawn a new tmux session (sends C-a S, see tmux.conf)
keybind = super+y=text:\x01S

# Windows (cmux "surfaces")
keybind = super+t=text:\x01c
keybind = super+w=text:\x01x
keybind = super+r=text:\x01,
keybind = super+shift+bracket_right=text:\x01n
keybind = super+shift+bracket_left=text:\x01p

# Toggle pane zoom (Cmd+Shift+Enter)
keybind = super+shift+enter=text:\x01z

# Cmd+1..9 intentionally left to Ghostty's default goto_tab:N
# (Ghostty tabs act as our "workspaces"; tmux windows are still
# reachable via the leader prefix C-a 1..9.)

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll
